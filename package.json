  "type": "module",
  "description": "Long-form fiction writing workflow preset for DeepSeek Harness",
  "license": "MIT",
  "author": "Haiyan Yang <angela.yhy25@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visangela/dsh-novel-assistant.git"
  },
  "homepage": "https://github.com/visangela/dsh-novel-assistant#readme",
  "keywords": [
    "dsh",
